# Vũ Hồn Family OS V24.1
# local | staging | production
VITE_APP_ENV=local

# static = đọc /data/*.json
# supabase = đọc Supabase nếu đã có URL/key + RLS
VITE_DATA_MODE=static

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# production phải để false nếu chưa có Supabase RLS thật
VITE_ENABLE_DEMO_ROLE_SWITCHER=true
